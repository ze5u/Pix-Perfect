# =============================================================================
# PixPerfect — environment template
# -----------------------------------------------------------------------------
# Copy this file and fill it in:
#     cp .env.example .env
#     npm run dev
#
# Rules:
#   * Every value below is a placeholder. Put your real ones in .env, which is
#     gitignored — never commit .env.
#   * NEXT_PUBLIC_* variables are shipped to the browser. Never give a secret a
#     NEXT_PUBLIC_ prefix.
#   * No live keys live in this repo.
# =============================================================================

# -----------------------------------------------------------------------------
# NEXT.JS
# -----------------------------------------------------------------------------
NODE_ENV=development

# Canonical site URL, used only so absolute metadata (canonical, OG tags)
# resolves. If unset, app/layout.tsx falls back to a placeholder value.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# -----------------------------------------------------------------------------
# CLERK — authentication  (https://dashboard.clerk.com)
# -----------------------------------------------------------------------------
# Environment -> Client ID / API keys.
# Publishable keys are safe to expose; they are still environment-specific.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY

# Server only. Also used to sign the Svix webhooks Clerk delivers.
# NEVER create a NEXT_PUBLIC_CLERK_SECRET_KEY.
CLERK_SECRET_KEY=sk_test_YOUR_SECRET_KEY

# Clerk -> Settings -> Customization -> Redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/home
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/home

# The public URL Clerk posts events to. Use your tunnel/app URL in production.
NEXT_PUBLIC_CLERK_WEBHOOK_URL=https://your-domain.com/api/webhooks/clerk

# Clerk -> Api Keys -> Create webhook secret.
# /api/webhooks/clerk verifies every inbound event against this value.
WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# -----------------------------------------------------------------------------
# MONGODB — Atlas  (https://www.mongodb.com/cloud/atlas)
# -----------------------------------------------------------------------------
# Database -> Connect -> Drivers. A trailing "/" before the slash in
# mongodb+srv://<user>:<password>@host/... is normal.
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-host>/<database>

# -----------------------------------------------------------------------------
# CLOUDINARY — image hosting + AI transformations
# -----------------------------------------------------------------------------
# Dashboard -> Your details (the name in your https://res.cloudinary.com/<name>/ URL)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Dashboard -> Settings -> API Keys
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Dashboard -> Settings -> Upload.
# Unsigned upload preset the browser uploads through (MediaUploader.tsx).
# Create it in Cloudinary with "Safe Uploads" checked.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
